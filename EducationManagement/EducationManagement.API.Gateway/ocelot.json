{
    "Routes": [
        // ============================================================
        // 🔹 AUTH SERVICE (Login / Refresh / Logout)
        // ============================================================
        {
            "DownstreamPathTemplate": "/api/auth/{everything}",
            "DownstreamScheme": "https",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 7299
                }
            ],
            "UpstreamPathTemplate": "/api-edu/auth/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ]
        },

        // ============================================================
        // 🔹 USER SERVICE (Profile / Update Avatar)
        // ============================================================
        {
            "DownstreamPathTemplate": "/api/users/{everything}",
            "DownstreamScheme": "https",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 7299
                }
            ],
            "UpstreamPathTemplate": "/api-edu/users/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
            "AuthenticationOptions": {
                "AuthenticationProviderKey": "Bearer",
                "AllowedScopes": []
            }
        },

        // ============================================================
        // 🔹 ADMIN SERVICE (Roles / Permissions / Users / Menu)
        // ============================================================
        {
            "DownstreamPathTemplate": "/api/admin/{everything}",
            "DownstreamScheme": "https",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 7299
                }
            ],
            "UpstreamPathTemplate": "/api-edu/admin/{everything}",
            "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
            "AuthenticationOptions": {
                "AuthenticationProviderKey": "Bearer",
                "AllowedScopes": []
            }
        },

        // ============================================================
        // 🔹 STATIC FILES (Avatars)
        // ============================================================
        {
            "DownstreamPathTemplate": "/avatars/{everything}",
            "DownstreamScheme": "https",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 7299
                }
            ],
            "UpstreamPathTemplate": "/avatars/{everything}",
            "UpstreamHttpMethod": [ "GET" ]
        }
    ],

    // ============================================================
    // 🔹 GLOBAL CONFIGURATION
    // ============================================================
    "GlobalConfiguration": {
        "BaseUrl": "https://localhost:7033"
    }
}
